pipeline {
    agent any

    stages {
        stage('Restore Dependencies') {
            steps {
                sh 'dotnet restore DemoQa.slnx'
            }
        }

        stage('Build Project') {
            steps {
                sh 'dotnet build DemoQa.slnx --no-restore'
            }
        }

        stage('Run MSTest Tests') {
            steps {
                sh 'dotnet test DemoQa.slnx --no-build --verbosity normal'
            }
        }
    }
}
